name = "moonbit-community/email"

version = "0.0.1"

import {
  "moonbitlang/async@0.22.5",
}

readme = "README.mbt.md"

repository = "https://github.com/moonbit-community/email"

license = "Apache-2.0"

keywords = [ "email", "smtp", "mime", "mail", "rfc5322", "moonbit" ]

description = "A MoonBit email library with facade APIs for composing, encoding, and sending messages over SMTP."

preferred_target = "native"
